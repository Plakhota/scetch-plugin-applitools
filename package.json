{
  "name": "applitools-sketch-plugin",
  "version": "0.1.0",
  "description": "Upload Sketch artboard screenshots to Applitools Eyes for visual testing.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Plakhota/scetch-plugin-applitools.git"
  },
  "engines": {
    "sketch": ">=97.0"
  },
  "skpm": {
    "name": "Applitools",
    "manifest": "src/manifest.json",
    "main": "applitools.sketchplugin",
    "assets": [
      "resources/**/*"
    ]
  },
  "scripts": {
    "build:ui": "webpack --config webpack.ui.config.js",
    "build": "npm run build:ui && skpm-build",
    "watch:ui": "webpack --config webpack.ui.config.js --watch",
    "watch": "skpm-build --watch",
    "start": "npm run build && skpm-build --run",
    "postinstall": "patch-package && npm run build && skpm-link"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-modules-commonjs": "^7.24.0",
    "@babel/plugin-transform-runtime": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@skpm/builder": "^1.0.0",
    "@types/node": "^18.19.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "html-webpack-inline-source-plugin": "0.0.10",
    "html-webpack-plugin": "^5.6.0",
    "inline-chunk-html-plugin": "^1.1.1",
    "patch-package": "^8.0.1",
    "sketch-module-web-view": "^3.5.3",
    "skpm": "^1.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@applitools/eyes-images": "4.21.0",
    "@babel/runtime": "^7.24.0",
    "assert": "^2.1.0",
    "axios": "0.21.1",
    "browser-process-hrtime": "^1.0.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "http-browserify": "^1.7.0",
    "https-browserify": "^1.0.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "timers-browserify": "^2.0.12",
    "url": "^0.11.0",
    "util": "^0.12.5"
  }
}
